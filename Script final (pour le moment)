#include <Servo.h>

Servo servo_11, servo_10, servo_9, servo_8, servo_7, servo_6;

// --- REGLAGE DE LA VITESSE ---
// Plus le chiffre est élevé, plus le mouvement est lent (ms entre chaque degré)
int vitesseGlobale = 10; 

void setup() {
  pinMode(5, INPUT_PULLUP);
  pinMode(4, INPUT_PULLUP);
  pinMode(3, INPUT_PULLUP);
  pinMode(2, INPUT_PULLUP);

  // Initialisation et position de départ 
  servo_6.attach(6, 500, 2500);
  servo_6.write(40);
  delay(500);
  
  servo_7.attach(7, 500, 2500);
  servo_7.write(130);
  delay(500);
  
  servo_8.attach(8, 500, 2500);
  servo_8.write(180);
  delay(500);
  
  servo_9.attach(9, 500, 2500);
  servo_9.write(80);
  delay(500);
  
  servo_10.attach(10, 500, 2500);
  servo_10.write(0);
  delay(500);
  
  servo_11.attach(11, 500, 2500);
  servo_11.write(120);
}

void loop() {

  if (digitalRead(5) == LOW) {
    deplacerServo(servo_6, 160, vitesseGlobale);
    executerMouvementCommun();
  } 
  
  else if (digitalRead(4) == LOW) {
    deplacerServo(servo_6, 135, vitesseGlobale);
    executerMouvementCommun();
  } 
 
  else if (digitalRead(3) == LOW) {
    deplacerServo(servo_6, 110, vitesseGlobale);
    executerMouvementCommun();
  } 
 
  else if (digitalRead(2) == LOW) {
    deplacerServo(servo_6, 85, vitesseGlobale);
    executerMouvementCommun();
  }
}

// FONCTION POUR GÉRER LA VITESSE
void deplacerServo(Servo &monServo, int angleCible, int vitesse) {
  int angleActuel = monServo.read();
  
  if (angleActuel < angleCible) {
    for (int pos = angleActuel; pos <= angleCible; pos++) {
      monServo.write(pos);
      delay(vitesse); 
    }
  } else {
    for (int pos = angleActuel; pos >= angleCible; pos--) {
      monServo.write(pos);
      delay(vitesse);
    }
  }
}

// FONCTION POUR LES MOUVEMENTS RÉPÉTITIFS
void executerMouvementCommun() {
    deplacerServo(servo_11, 150, vitesseGlobale);
    deplacerServo(servo_7, 60, vitesseGlobale);
    deplacerServo(servo_8, 170, vitesseGlobale);
    deplacerServo(servo_9, 80, vitesseGlobale);
    deplacerServo(servo_10, 40, vitesseGlobale);
    deplacerServo(servo_11, 50, vitesseGlobale);
    deplacerServo(servo_8, 160, vitesseGlobale);
    deplacerServo(servo_6, 40, vitesseGlobale);
    deplacerServo(servo_11, 140, vitesseGlobale);
    deplacerServo(servo_6, 40, vitesseGlobale);
    deplacerServo(servo_7, 130, vitesseGlobale);
    deplacerServo(servo_8, 180, vitesseGlobale);
    deplacerServo(servo_9, 80, vitesseGlobale);
    deplacerServo(servo_10, 0, vitesseGlobale);
    deplacerServo(servo_11, 120, vitesseGlobale);
}
